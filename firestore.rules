rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  دوال مساعدة
    // ═══════════════════════════════════════════════════════════════

    /// يتحقق من أن المستخدم هو أحد المسؤولَين المعتمدَين حصراً
    function isAdmin() {
      return request.auth != null &&
        request.auth.token != null &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'mma831770@gmail.com' ||
         request.auth.token.email == 'abdellahismd@gmail.com');
    }

    /// يتحقق من أن المستخدم الحالي هو صاحب المستند
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /// يتحقق من أن المستخدم مسجل الدخول
    function isAuthenticated() {
      return request.auth != null;
    }

    /// يتحقق من أن حقل البيانات المُرسَلة لا يحتوي على حقول حساسة
    function noSensitiveFields() {
      return !request.resource.data.keys().hasAny([
        'isAdmin', 'isSuspended', 'mustChangePassword', 'points'
      ]);
    }

    // ═══════════════════════════════════════════════════════════════
    //  المستخدمون /users/{userId}
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // القراءة المفردة: المالك أو المسؤول فقط
      allow get: if isOwner(userId) || isAdmin();

      // list (استعلام): مسموح للمستخدمين المسجلين فقط بغرض التحقق من رقم الهاتف
      // (يُستخدم في signUp للتحقق من تفرد الهاتف بعد إنشاء Auth)
      allow list: if isAuthenticated();

      // إنشاء مستند جديد: المستخدم ينشئ مستنده الخاص فقط عند التسجيل
      allow create: if isOwner(userId);

      // تعديل: المالك (بدون حقول حساسة) أو المسؤول بصلاحيات كاملة
      allow update: if (isOwner(userId) && noSensitiveFields()) || isAdmin();

      // حذف: المسؤول فقط
      allow delete: if isAdmin();

      // ── المجموعات الفرعية للمستخدم (إشعارات، ملاحظات، إلخ) ──
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  سجلات طلبات OTP /otp_requests_logs/{logId}
    // ═══════════════════════════════════════════════════════════════
    match /otp_requests_logs/{logId} {
      // الكتابة: أي مستخدم مسجل (لتسجيل طلبه)، أو النظام (auth=null في Functions)
      allow create: if isAuthenticated() || request.auth == null;
      // القراءة والتعديل والحذف: المسؤول فقط
      allow read, update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  سجلات النشاط الإداري
    // ═══════════════════════════════════════════════════════════════
    match /admin_activity_logs/{logId} {
      allow read, write: if isAdmin();
      // السماح للمستخدمين المسجلين بالكتابة فقط (لتسجيل أنشطتهم)
      allow create: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  إعدادات التطبيق والصيانة
    // ═══════════════════════════════════════════════════════════════
    match /app_settings/{settingId} {
      // الجميع يقرأ (مطلوب لشاشة الصيانة)
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /maintenance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  الكتب والمحتوى
    // ═══════════════════════════════════════════════════════════════
    match /books/{bookId} {
      // القراءة: المستخدمون المسجلون فقط
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  الإشعارات العامة
    // ═══════════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // نتائج المسابقات المنشورة تُعرض داخل التطبيق للمستخدمين.
    // الكتابة محصورة بالإدارة حتى لا يتم العبث بالروابط أو الترتيب.
    match /competition_results/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // التقييمات العامة: القراءة متاحة، والكتابة محصورة في صاحب التقييم.
    // لا يعتمد التطبيق على البريد الإلكتروني في العرض أو التخزين.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        request.auth.uid == reviewId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'rating', 'text', 'userId', 'userName', 'createdAt'
        ]);
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == reviewId);
    }

    // ═══════════════════════════════════════════════════════════════
    //  الإحصائيات
    // ═══════════════════════════════════════════════════════════════
    match /statistics/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  ملاحظة أمنية: لا يوجد wildcard fallback هنا
    //  كل مسار يجب أن يكون محدداً صراحةً أعلاه
    //  أي مسار غير مذكور يُرفض تلقائياً
    // ═══════════════════════════════════════════════════════════════
  }
}

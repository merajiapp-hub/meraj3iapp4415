rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  دوال مساعدة
    // ═══════════════════════════════════════════════════════════════

    /// المسؤولان الأساسيان الموثوقان.
    function isRootAdmin() {
      return request.auth != null &&
        request.auth.token != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'mma831770@gmail.com' ||
         request.auth.token.email == 'abdellahismd@gmail.com');
    }

    /// الصلاحيات التفصيلية تحفظ في ملف الحساب ولا يستطيع العميل تعديلها.
    function hasAdminPermission(permission) {
      return isRootAdmin() ||
        (request.auth != null &&
         request.auth.token.email_verified == true &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminActive == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminPermissions is list &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminPermissions.hasAny([permission]));
    }

    /// يتحقق من أن المستخدم الحالي هو صاحب المستند
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function protectedAdminFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isAdmin', 'adminActive', 'adminPermissions', 'role', 'adminRoleName',
        'adminCreatedAt', 'adminCreatedBy', 'adminUpdatedAt', 'adminUpdatedBy',
        'lastAdminActivityAt',
        'isSuspended', 'accountStatus', 'suspensionReason', 'suspensionStartAt',
        'suspensionEndAt', 'suspendedAt', 'suspendedBy', 'mustChangePassword',
        'deletionRequestedAt', 'deletionRequestedBy', 'deletedAt', 'isBanned'
      ]);
    }

    /// يتحقق من أن المستخدم مسجل الدخول
    function isAuthenticated() {
      return request.auth != null;
    }

    function validBookClassification(data) {
      return (!data.keys().hasAny(['documentType']) ||
          data.documentType in ['book', 'exam', 'solution']) &&
        (!data.keys().hasAny(['examKey']) ||
          (data.examKey is string && data.examKey.size() <= 200));
    }

    function validBookClassificationUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return (!changedKeys.hasAny(['documentType']) ||
          request.resource.data.documentType in ['book', 'exam', 'solution']) &&
        (!changedKeys.hasAny(['examKey']) ||
          (request.resource.data.examKey is string &&
           request.resource.data.examKey.size() <= 200));
    }

    /// يتحقق من أن حقل البيانات المُرسَلة لا يحتوي على حقول حساسة
    function noSensitiveFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'fullName', 'firstName', 'lastName', 'gender', 'educationLevel',
        'email', 'phone', 'phoneNumber', 'phoneNormalized',
        'profileImageUrl', 'profileImageBase64', 'photoUrl',
        'fcmToken', 'fcmTokens', 'lastTokenUpdate',
        'provider', 'authProvider',
        'failedLoginAttempts', 'needsSupport', 'lastLoginAttemptAt',
        'lastLoginSuccessAt', 'lastLoginFailureAt', 'lastLoginFailureReason',
        'loginActivityUpdatedAt',
        'updatedAt', 'lastLoginAt', 'lastActivity'
      ]);
    }

    function noSensitiveCreateFields() {
      return !request.resource.data.keys().hasAny([
        'isAdmin', 'isSuspended', 'accountStatus', 'suspensionReason',
        'suspensionStartAt', 'suspensionEndAt', 'suspendedAt', 'suspendedBy',
        'mustChangePassword', 'points', 'adminActive', 'adminPermissions',
        'adminRoleName', 'adminCreatedAt', 'adminCreatedBy', 'adminUpdatedAt',
        'adminUpdatedBy'
      ]);
    }

    // ═══════════════════════════════════════════════════════════════
    //  المستخدمون /users/{userId}
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // القراءة المفردة: المالك أو المسؤول فقط
      allow get: if isOwner(userId) || hasAdminPermission('users.view');

      // Enumeration and profile lookups are restricted to admins. The mobile
      // app must move phone lookup to a trusted backend before these rules ship.
      allow list: if hasAdminPermission('users.view') ||
        hasAdminPermission('roles.manage');

      // إنشاء مستند جديد: المستخدم ينشئ مستنده الخاص فقط عند التسجيل
      // الشروط:
      // 1. المستخدم هو صاحب المستند (isOwner)
      // 2. uid في البيانات يطابق uid المسار
      // 3. لا تحتوي البيانات على حقول إدارية حساسة
      // 4. role إما غير موجود أو قيمته 'user' فقط
      // 5. isActive إما غير موجود أو قيمته true فقط (لا يستطيع تفعيل نفسه يدوياً)
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        noSensitiveCreateFields() &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user') &&
        (!request.resource.data.keys().hasAny(['isActive']) || request.resource.data.isActive == true);

      // تعديل: المالك (بدون حقول حساسة) أو المسؤول بصلاحيات كاملة
      allow update: if (isOwner(userId) && noSensitiveFields()) ||
        (hasAdminPermission('users.update') && protectedAdminFieldsUnchanged());

      // Account deletion is performed only by the trusted callable function.
      allow delete: if false;

      // ── المجموعات الفرعية للمستخدم (إشعارات، ملاحظات، إلخ) ──
      match /{subcollection}/{docId} {
        allow read: if isOwner(userId) ||
          (subcollection == 'notifications' &&
            hasAdminPermission('notifications.view')) ||
          hasAdminPermission('users.view');
        allow write: if isOwner(userId) ||
          (subcollection == 'notifications' &&
            hasAdminPermission('notifications.manage'));
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  سجلات طلبات OTP /otp_requests_logs/{logId}
    // ═══════════════════════════════════════════════════════════════
    match /otp_requests_logs/{logId} {
      // الكتابة: أي مستخدم مسجل (لتسجيل طلبه)، أو النظام (auth=null في Functions)
      allow create: if isAuthenticated() || request.auth == null;
      // القراءة والتعديل والحذف: المسؤول فقط
      allow read: if hasAdminPermission('security.view');
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  سجلات النشاط الإداري
    // ═══════════════════════════════════════════════════════════════
    match /admin_activity_logs/{logId} {
      allow read: if hasAdminPermission('activity.view');
      allow write: if false;
    }

    // Legacy activity collection used by the standalone admin dashboard.
    match /admin_activity/{logId} {
      allow read: if hasAdminPermission('activity.view');
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasAdminPermission('security.view');
      allow write: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if hasAdminPermission('roles.manage');
      allow write: if false;
    }

    match /admin_roles/{roleId} {
      allow read: if hasAdminPermission('roles.manage');
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  إعدادات التطبيق والصيانة
    // ═══════════════════════════════════════════════════════════════
    match /app_settings/{settingId} {
      // التطبيق العام لا يفتح بدون تسجيل الدخول، وتبقى إعدادات الإدارة محصورة بالإدارة فقط.
      allow read: if isAuthenticated();
      allow write: if hasAdminPermission('settings.manage');
    }

    match /admin_settings/{document} {
      // Feature flags are public to signed-in clients; other admin settings remain private.
      allow read: if hasAdminPermission('settings.manage') ||
        hasAdminPermission('feature_flags.manage') ||
        (isAuthenticated() && document == 'feature_flags');
      allow write: if hasAdminPermission('settings.manage') ||
        hasAdminPermission('feature_flags.manage');
    }

    // General application settings used by the admin web panel.
    match /app_config/{document} {
      allow read: if hasAdminPermission('settings.manage');
      allow write: if hasAdminPermission('settings.manage');
    }

    match /maintenance/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminPermission('settings.manage');
    }

    // ═══════════════════════════════════════════════════════════════
    //  الكتب والمحتوى
    // ═══════════════════════════════════════════════════════════════
    match /books/{bookId} {
      // القراءة: المستخدمون المسجلون فقط
      allow read: if isAuthenticated();
      // count() و list() ضروريان لعرض إحصائيات لوحة الإدارة.
      allow list: if hasAdminPermission('books.view');
      // الإدارة والتحميل الذاتي المصرح به يحافظان على تصنيف صالح.
      allow create: if validBookClassification(request.resource.data) &&
        (hasAdminPermission('books.create') ||
         (isAuthenticated() &&
          request.resource.data.uploaderId == request.auth.uid));
      allow update: if hasAdminPermission('books.update') && validBookClassificationUpdate();
      allow delete: if hasAdminPermission('books.delete');
    }

    // ═══════════════════════════════════════════════════════════════
    //  فئات المراجع (نظام القوائم الهرمي الجديد)
    // ═══════════════════════════════════════════════════════════════
    match /reference_categories/{categoryId} {
      // القراءة: كل المستخدمين المسجلين (مطلوب لعرضها في التطبيق)
      allow read: if isAuthenticated();
      allow list: if hasAdminPermission('categories.view');
      // الكتابة (إنشاء، تعديل، حذف): المسؤول فقط
      allow create, update, delete: if hasAdminPermission('categories.manage');
    }

    // نسخة التوافق القديمة التي ما زالت تستخدمها بعض شاشات التطبيق.
    match /uploaded_books/{bookId} {
      allow read: if isAuthenticated();
      allow create: if hasAdminPermission('books.create') ||
        (isAuthenticated() && request.resource.data.uploaderId == request.auth.uid);
      allow update: if hasAdminPermission('books.update');
      allow delete: if hasAdminPermission('books.delete');
    }

    // بنك الأسئلة: القراءة للتطبيق، والإدارة للكتابة.
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      // لوحة الإدارة تستخدم count() على هذه المجموعة لا على الاستعلامات الفرعية.
      allow list: if hasAdminPermission('quizzes.view');
      allow create, update, delete: if hasAdminPermission('quizzes.manage');

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow list: if hasAdminPermission('questions.view');
        allow create, update, delete: if hasAdminPermission('questions.manage');
      }
    }

    function isValidSupportMessageAlert(notificationId) {
      let notification = request.resource.data;
      let chatPath = /databases/$(database)/documents/chats/$(notification.chatId);
      let messagePath = /databases/$(database)/documents/chats/$(notification.chatId)/messages/$(notification.messageId);
      return isAuthenticated() &&
        notification.keys().hasOnly([
          'type', 'chatId', 'messageId', 'userId', 'userName',
          'userEmail', 'excerpt', 'readBy', 'eventAt', 'createdAt'
        ]) &&
        notification.type == 'support_message' &&
        notificationId == notification.messageId &&
        notification.chatId is string &&
        notification.messageId is string &&
        notification.userId == request.auth.uid &&
        notification.userName is string &&
        notification.userEmail is string &&
        notification.excerpt is string &&
        notification.readBy is map &&
        notification.readBy.keys().size() == 0 &&
        notification.eventAt == request.time &&
        notification.createdAt == request.time &&
        getAfter(chatPath).data.userId == request.auth.uid &&
        getAfter(messagePath).data.senderId == request.auth.uid &&
        getAfter(messagePath).data.isAdmin == false &&
        getAfter(messagePath).data.createdAt == request.time;
    }

    // إشعارات لوحة الإدارة.
    match /admin_notifications/{notificationId} {
      allow read: if hasAdminPermission('support.view') ||
        hasAdminPermission('notifications.view');
      allow create: if hasAdminPermission('notifications.manage') ||
        hasAdminPermission('support.manage') ||
        isValidSupportMessageAlert(notificationId);
      allow update, delete: if hasAdminPermission('support.manage') ||
        hasAdminPermission('notifications.manage');
    }

    match /app_config/{document} {
      allow read: if hasAdminPermission('settings.manage') ||
        hasAdminPermission('feature_flags.manage') ||
        (isAuthenticated() && document == 'settings');
      allow write: if hasAdminPermission('settings.manage') ||
        hasAdminPermission('feature_flags.manage');
    }
    match /news/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('news.manage'); }
    match /announcements/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('announcements.manage'); }
    match /lessons/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('lessons.manage'); }
    match /exams/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('quizzes.manage'); }
    match /questions/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('questions.manage'); }
    match /app_releases/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('releases.manage'); }
    match /system_health/{document=**} { allow read: if hasAdminPermission('system_health.view'); allow write: if hasAdminPermission('settings.manage'); }
    match /security_logs/{document=**} { allow read: if hasAdminPermission('security.view'); allow write: if false; }
    match /activity_logs/{document=**} { allow read: if hasAdminPermission('activity.view'); allow write: if false; }
    match /admin_activity/{document=**} { allow read: if hasAdminPermission('activity.view'); allow write: if false; }
    match /error_logs/{document=**} { allow read: if hasAdminPermission('errors.view'); allow write: if false; }
    match /books/{document=**} {
      allow read: if isAuthenticated();
      allow create: if hasAdminPermission('books.create') &&
        validBookClassification(request.resource.data);
      allow update: if hasAdminPermission('books.update') &&
        validBookClassificationUpdate();
      allow delete: if hasAdminPermission('books.delete');
    }
    match /grades/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('grades.manage'); }
    match /subjects/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('subjects.manage'); }
    match /remote_config/{document=**} { allow read: if isAuthenticated(); allow write: if hasAdminPermission('settings.manage') || hasAdminPermission('feature_flags.manage'); }

    // Admin dashboard/report aggregate counts for legacy content collections.
    match /solutions/{solutionId} {
      allow list: if hasAdminPermission('books.view');
    }
    match /swedd/{documentId} {
      allow list: if hasAdminPermission('books.view');
    }
    match /swedd_books/{bookId} {
      allow list: if hasAdminPermission('books.view');
    }

    // Login activity is written only by the trusted Cloud Function and read by admins.
    match /login_attempts/{attemptId} {
      allow read: if hasAdminPermission('security.view');
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'result', 'method', 'reason', 'authCode',
          'identifierMasked', 'platform', 'deviceType', 'deviceModel',
          'osVersion', 'appVersion', 'buildNumber',
          'consecutiveFailedAttempts', 'needsSupport', 'createdAt'
        ]) &&
        request.resource.data.result is string &&
        request.resource.data.method is string &&
        request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /unlinked_login_attempts/{attemptId} {
      allow read: if hasAdminPermission('security.view');
      allow write: if false;
    }

    match /login_rate_limits/{rateId} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  الإشعارات العامة
    // ═══════════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow list: if hasAdminPermission('notifications.view');
      allow write: if hasAdminPermission('notifications.manage');
    }

    // بيانات لوحة الشرف القديمة غير موثوقة، فلا تُقرأ ولا تُكتب من العملاء.
    match /leaderboard/{userId} {
      allow read, write: if false;
    }

    // The trusted Functions pipeline is the only writer for verified rankings.
    match /honor_board/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /honor_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /honor_best_results/{resultId} {
      allow read, write: if false;
    }

    // Certificates are issued by admins and readable only by the recipient.
    match /student_certificates/{certificateId} {
      allow read: if hasAdminPermission('honor.view') ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if hasAdminPermission('honor.manage');
      allow update, delete: if hasAdminPermission('honor.manage');
    }

    // نتائج المسابقات المنشورة تُعرض داخل التطبيق للمستخدمين.
    // الكتابة محصورة بالإدارة حتى لا يتم العبث بالروابط أو الترتيب.
    match /competition_results/{competitionId} {
      allow read: if isAuthenticated();
      allow list: if hasAdminPermission('results.view');
      allow write: if hasAdminPermission('results.manage');
    }

    // محاولات الاختبارات: يقرأ الطالب محاولاته فقط وينشئ محاولته بنفسه.
    match /exam_attempts/{attemptId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         hasAdminPermission('results.view') ||
         hasAdminPermission('honor.view'));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // التقييمات العامة: القراءة متاحة، والكتابة محصورة في صاحب التقييم.
    // لا يعتمد التطبيق على البريد الإلكتروني في العرض أو التخزين.
    match /reviews/{reviewId} {
      // التطبيق العام لا يُفتح بدون تسجيل الدخول، ولكن تقييمات المحتوى تبقى للموظفين/الناس المسجلين فقط.
      allow read: if isAuthenticated();
      allow list: if hasAdminPermission('reviews.view');
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'rating', 'text', 'userId', 'userName', 'photoUrl', 'status',
          'moderation', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.status == 'published' &&
        request.resource.data.moderation == 'none';
      allow update: if hasAdminPermission('reviews.moderate') || (isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'text', 'status', 'moderation', 'updatedAt'
        ]) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.status == 'published' &&
        request.resource.data.moderation == 'none');
      allow delete: if hasAdminPermission('reviews.delete');
    }

    // قائمة المراجعة لا تُكشف للمستخدمين؛ الفحص النهائي يجب أن يتم في الإدارة.
    match /bad_words/{wordId} {
      allow read, write: if hasAdminPermission('bad_words.manage');
      allow list: if hasAdminPermission('bad_words.manage');
    }

    match /chats/{chatId} {
      allow list: if hasAdminPermission('support.view');
      // The client checks whether its chat exists before creating the first
      // message. A missing document must be readable as a non-existent chat,
      // while existing chats remain restricted to their owner or admins.
      allow read: if isAuthenticated() &&
        (!exists(/databases/$(database)/documents/chats/$(chatId)) ||
         resource.data.userId == request.auth.uid ||
         hasAdminPermission('support.view'));
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAny(['userId', 'lastMessage']);
      allow update: if hasAdminPermission('support.manage') ||
        (isAuthenticated() && resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'userName', 'lastMessage', 'lastMessageAt', 'updatedAt', 'userUnread', 'adminUnread'
          ]));
      allow delete: if hasAdminPermission('support.manage');

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid ||
           hasAdminPermission('support.view'));
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'isAdmin', 'createdAt', 'isRead']) &&
          request.resource.data.text is string &&
          ((request.resource.data.isAdmin == false) ||
           (request.resource.data.isAdmin == true &&
            hasAdminPermission('support.manage')));
        allow update: if hasAdminPermission('support.manage') || (isAuthenticated() &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt', 'deletedBy']) &&
          request.resource.data.isDeleted == true &&
          request.resource.data.deletedBy == request.auth.uid);
        allow delete: if hasAdminPermission('support.manage');
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  الإحصائيات
    // ═══════════════════════════════════════════════════════════════
    match /statistics/{statId} {
      allow read: if isAuthenticated();
      allow list: if hasAdminPermission('analytics.view');
      allow write: if hasAdminPermission('settings.manage');
    }

    // ═══════════════════════════════════════════════════════════════
    //  ملاحظة أمنية: لا يوجد wildcard fallback هنا
    //  كل مسار يجب أن يكون محدداً صراحةً أعلاه
    //  أي مسار غير مذكور يُرفض تلقائياً
    // ═══════════════════════════════════════════════════════════════
  }
}
